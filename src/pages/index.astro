---
// index.astro
import Layout from '../layouts/Layout.astro';

const profile = 'https://github.com/b1000mk';

const projects = [
  {
    name: 'cfnew 面板',
    description: '多协议订阅合流转换、节点过滤、全自动化更新部署。',
    repo: 'my-cfnew',
  },
  {
    name: 'my-homepage',
    description: 'Astro 5 个人主页与技术展示集。',
    repo: 'my-homepage',
  },
  {
    name: 'GithubCK',
    description: 'Git 笔记与自动化工具。',
    repo: 'GithubCK',
  },
];

const tools = [
  'Cloudflare Workers',
  'Cloudflare Pages',
  'Git & GitHub',
  'GitHub Actions',
  'JavaScript / TS',
  'Astro',
  'Modern CSS',
  'API & Subscription',
];

const principles = [
  { name: '极简纯粹主义', description: '去除冗余，只保留必要的界面与代码。' },
  { name: '边缘优先架构', description: '将计算与响应尽可能下沉到网络边缘。' },
  { name: '自动化与 GitOps', description: '一切部署与流程皆可由仓库驱动。' },
];
---

<Layout
  title="b1000mk · 个人主页与开源探索"
  description="探索 b1000mk 的 cfnew 面板、my-homepage 与 GithubCK 开源作品，关注 Cloudflare 边缘计算与自动化。"
>
  <div class="page">
    <header class="hero">
      <p class="eyebrow">b1000mk</p>
      <h1 class="editorial-title">路漫漫其修远</h1>
      <p class="hero-sub">吾将上下而求索</p>
      <p class="hero-intro">边缘计算、Cloudflare 全球网络、自动化流程与极简高表现 Web 界面设计。</p>
      <div class="hero-actions">
        <a class="btn" href={profile} target="_blank" rel="noopener noreferrer">GitHub 主页</a>
        <a class="hero-link" href={profile} target="_blank" rel="noopener noreferrer">https://github.com/b1000mk</a>
      </div>
    </header>

    <section class="section" aria-label="开源项目">
      <div class="section-head">
        <span class="section-num">01</span>
        <h2 class="section-title">项目</h2>
      </div>

      {projects.map((project, i) => (
        <article class="project">
          <span class="project-num">0{i + 1}</span>
          <div class="project-body">
            <h3 class="project-title">{project.name}</h3>
            <p class="project-desc">{project.description}</p>
            <a
              class="repo-link"
              href={`https://github.com/b1000mk/${project.repo}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>github.com/b1000mk/{project.repo}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </section>

    <section class="section" aria-label="技术与工具栈">
      <div class="section-head">
        <span class="section-num">02</span>
        <h2 class="section-title">工具</h2>
      </div>
      <ul class="tools">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>

    <section class="section" aria-label="设计与构建哲学">
      <div class="section-head">
        <span class="section-num">03</span>
        <h2 class="section-title">理念</h2>
      </div>
      <ol class="principles">
        {principles.map((principle, i) => (
          <li class="principle">
            <span class="principle-num">{i + 1}</span>
            <p><strong>{principle.name}</strong> — {principle.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <div class="section-head">
        <span class="section-num">04</span>
        <h2 class="section-title">联系</h2>
      </div>
      <div class="footer-actions">
        <a class="btn" href={profile} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 2.5-.35c.85 0 1.71.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
          </svg>
          在 GitHub 上联系
        </a>
        <div class="copy-row">
          <a class="hero-link" href={profile} target="_blank" rel="noopener noreferrer">github.com/b1000mk</a>
          <button id="copy-profile" class="icon-btn" type="button" aria-label="复制个人资料链接" title="复制个人资料链接">
            <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </button>
        </div>
      </div>
      <p id="copy-status" class="copy-status" aria-live="polite"></p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-profile');
      var status = document.getElementById('copy-status');
      if (!btn || !status) return;
      var url = 'https://github.com/b1000mk';

      btn.addEventListener('click', function () {
        if (!navigator.clipboard) {
          status.textContent = '无法自动复制，请长按上方链接复制。';
          return;
        }
        navigator.clipboard.writeText(url).then(
          function () {
            status.textContent = '已复制链接';
            btn.setAttribute('data-state', 'copied');
            window.setTimeout(function () {
              status.textContent = '';
              btn.removeAttribute('data-state');
            }, 2500);
          },
          function () {
            status.textContent = '无法自动复制，请长按上方链接复制。';
          }
        );
      });
    })();
  </script>
</Layout>
