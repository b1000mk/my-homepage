---
// convert.astro
import Layout from '../layouts/Layout.astro';

const notes = [
  { name: '本地处理', description: '解析与生成都在这个页面里完成，不会把订阅地址或节点内容发送到任何转换服务。' },
  { name: '支持协议', description: 'Shadowsocks、VMess（新版链接与旧版 base64）、VLESS、Trojan、Hysteria2、TUIC，含 WS / gRPC / h2 / Reality 传输参数。' },
  { name: '订阅地址读不到', description: '部分订阅地址不允许浏览器直接读取。遇到这种情况，请在浏览器打开该地址，把页面内容复制到文本框里再转换。' },
  { name: '导出模板', description: '不同客户端版本的参数名会有差异，导入后请确认每个节点都能连通。' },
  { name: '想要可分享链接', description: '这里生成的是配置内容。把它放到自己的 GitHub Gist 或 Cloudflare R2，就能得到一个可以随时导入的订阅地址。' },
];
---

<Layout
  title="订阅链接转换 · b1000mk"
  description="在浏览器本地把订阅链接转换成 Clash、V2Ray、Surge、Quantumult X 可用的配置，支持 Shadowsocks、VMess、VLESS、Trojan、Hysteria2、TUIC。"
>
  <div class="page">
    <header class="hero">
      <div class="hero-top">
        <p class="eyebrow">b1000mk</p>
        <nav class="site-nav" aria-label="主导航">
          <a href="/">首页</a>
          <a href="/convert" aria-current="page">订阅转换</a>
        </nav>
      </div>
      <h1 class="page-title">订阅链接转换</h1>
      <p class="hero-intro">粘贴订阅地址或订阅内容，选择目标客户端，立刻得到可以直接导入的配置。整个过程在浏览器本地完成，订阅内容不会离开这个页面。</p>
    </header>

    <section class="section" aria-label="输入">
      <div class="section-head">
        <span class="section-num">01</span>
        <h2 class="section-title">输入</h2>
      </div>
      <div class="input-row">
        <input id="sub-url" class="text-input" type="url" placeholder="订阅地址 https://…（可留空）" aria-label="订阅地址" />
        <button id="btn-convert" class="btn" type="button">转换</button>
      </div>
      <textarea
        id="sub-content"
        class="text-area"
        placeholder="也可以直接粘贴订阅内容：base64 整包，或者一行一个 ss:// / vmess:// / vless:// / trojan:// 节点链接。"
        aria-label="订阅内容"
        spellcheck="false"
      ></textarea>
      <div class="btn-row">
        <button id="btn-sample" class="btn btn-outline" type="button">载入示例</button>
        <button id="btn-clear" class="btn btn-ghost" type="button">清空</button>
      </div>
    </section>

    <section class="section" aria-label="目标格式">
      <div class="section-head">
        <span class="section-num">02</span>
        <h2 class="section-title">目标格式</h2>
      </div>
      <div id="format-group" class="format-group" role="radiogroup" aria-label="目标客户端格式"></div>
      <p id="format-hint" class="format-hint"></p>
    </section>

    <section class="section" aria-label="输出">
      <div class="section-head">
        <span class="section-num">03</span>
        <h2 class="section-title">输出</h2>
      </div>
      <p id="convert-message" class="copy-status" aria-live="polite"></p>
      <p id="convert-summary" class="format-hint" hidden></p>
      <ul id="node-list" class="node-list" hidden></ul>
      <textarea id="sub-output" class="text-area output-area" readonly placeholder="转换结果会显示在这里。" aria-label="转换结果" spellcheck="false"></textarea>
      <div class="btn-row">
        <button id="btn-copy" class="btn" type="button" disabled>复制结果</button>
        <button id="btn-download" class="btn btn-outline" type="button" disabled>下载</button>
        <span id="copy-status" class="copy-status" aria-live="polite"></span>
      </div>
    </section>

    <footer class="footer">
      <div class="section-head">
        <span class="section-num">04</span>
        <h2 class="section-title">说明</h2>
      </div>
      <ul class="notes">
        {notes.map((note) => (
          <li class="note">
            <span class="note-name">{note.name}</span>
            <p class="note-desc">{note.description}</p>
          </li>
        ))}
      </ul>
      <div class="site-info">
        <p id="info-server" hidden></p>
        <p id="info-visitor">正在检测您的网络信息……</p>
        <p>本站已稳定运行 <span id="info-uptime">……</span></p>
      </div>
    </footer>
  </div>

  <script>
    import {
      FORMATS,
      formatOf,
      parseSubscription,
      renderFormat,
      sampleSubscription,
      summaryOf,
      type FormatId,
      type ParseResult,
    } from '../lib/subscribe';

    const urlInput = document.getElementById('sub-url') as HTMLInputElement;
    const contentInput = document.getElementById('sub-content') as HTMLTextAreaElement;
    const outputArea = document.getElementById('sub-output') as HTMLTextAreaElement;
    const convertBtn = document.getElementById('btn-convert') as HTMLButtonElement;
    const sampleBtn = document.getElementById('btn-sample') as HTMLButtonElement;
    const clearBtn = document.getElementById('btn-clear') as HTMLButtonElement;
    const copyBtn = document.getElementById('btn-copy') as HTMLButtonElement;
    const downloadBtn = document.getElementById('btn-download') as HTMLButtonElement;
    const messageEl = document.getElementById('convert-message') as HTMLParagraphElement;
    const summaryEl = document.getElementById('convert-summary') as HTMLParagraphElement;
    const nodeListEl = document.getElementById('node-list') as HTMLUListElement;
    const formatGroup = document.getElementById('format-group') as HTMLDivElement;
    const formatHint = document.getElementById('format-hint') as HTMLParagraphElement;
    const copyStatus = document.getElementById('copy-status') as HTMLSpanElement;

    let format: FormatId = 'clash';
    let parsed: ParseResult | null = null;

    function refreshOutput() {
      const output = parsed ? renderFormat(parsed, format) : '';
      outputArea.value = output;
      copyBtn.disabled = !output;
      downloadBtn.disabled = !output;
      const active = formatOf(format);
      formatHint.textContent = active.hint;
      downloadBtn.textContent = '下载 ' + active.file;
      if (parsed && parsed.nodes.length > 0) {
        summaryEl.textContent = summaryOf(parsed);
        summaryEl.hidden = false;
        nodeListEl.innerHTML = '';
        for (const node of parsed.nodes) {
          const li = document.createElement('li');
          const name = document.createElement('span');
          name.className = 'node-name';
          name.textContent = node.name;
          const meta = document.createElement('span');
          meta.className = 'node-meta';
          meta.textContent = node.type + ' · ' + (node.network ?? 'tcp');
          li.append(name, meta);
          nodeListEl.appendChild(li);
        }
        nodeListEl.hidden = false;
      } else {
        summaryEl.hidden = true;
        nodeListEl.hidden = true;
      }
    }

    for (const f of FORMATS) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'format-btn';
      btn.setAttribute('role', 'radio');
      btn.textContent = f.label;
      btn.addEventListener('click', () => {
        format = f.id;
        for (const el of formatGroup.querySelectorAll('.format-btn')) {
          el.setAttribute('aria-checked', String(el === btn));
        }
        refreshOutput();
      });
      btn.setAttribute('aria-checked', String(f.id === format));
      formatGroup.appendChild(btn);
    }
    refreshOutput();

    async function convert() {
      const target = urlInput.value.trim();
      let text = contentInput.value;
      if (target) {
        convertBtn.disabled = true;
        convertBtn.textContent = '正在读取';
        messageEl.textContent = '正在读取订阅地址……';
        try {
          const res = await fetch(target, { credentials: 'omit' });
          if (!res.ok) throw new Error(String(res.status));
          text = await res.text();
          contentInput.value = text;
        } catch {
          convertBtn.disabled = false;
          convertBtn.textContent = '转换';
          parsed = null;
          refreshOutput();
          messageEl.textContent = '这个订阅地址无法在浏览器里直接读取（通常是服务端没有开放跨域访问）。请在浏览器打开该地址，把页面内容复制到下方文本框，再点一次转换。';
          return;
        }
        convertBtn.disabled = false;
        convertBtn.textContent = '转换';
      }
      const result = parseSubscription(text);
      parsed = result;
      refreshOutput();
      if (!result.nodes.length && !result.unknown.length) {
        messageEl.textContent = '没有读到可解析的内容。请粘贴订阅地址返回的文本，或者一行一个节点链接。';
        return;
      }
      messageEl.textContent = '';
    }

    convertBtn.addEventListener('click', convert);

    sampleBtn.addEventListener('click', () => {
      const sample = sampleSubscription();
      contentInput.value = sample;
      parsed = parseSubscription(sample);
      messageEl.textContent = '';
      refreshOutput();
    });

    clearBtn.addEventListener('click', () => {
      urlInput.value = '';
      contentInput.value = '';
      parsed = null;
      messageEl.textContent = '';
      refreshOutput();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(outputArea.value);
        copyBtn.textContent = '已复制';
        window.setTimeout(() => { copyBtn.textContent = '复制结果'; }, 2500);
      } catch {
        copyStatus.textContent = '无法自动复制，请在结果框里全选复制。';
      }
    });

    downloadBtn.addEventListener('click', () => {
      const blob = new Blob([outputArea.value], { type: 'text/plain;charset=utf-8' });
      const href = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = href;
      a.download = formatOf(format).file;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(href);
    });
  </script>

  <script is:inline>
    (function () {
      // 站点稳定运行的起始时间（第 5 天起算；如需调整只改这里）
      var START = new Date('2026-10-04T11:56:00+08:00');
      var up = document.getElementById('info-uptime');
      var serverEl = document.getElementById('info-server');
      var visitorEl = document.getElementById('info-visitor');

      function flag(cc) {
        cc = (cc || '').trim().toUpperCase();
        if (!/^[A-Z]{2}$/.test(cc)) return '';
        return String.fromCodePoint.apply(null, cc.split('').map(function (c) {
          return 0x1f1e6 + c.charCodeAt(0) - 65;
        }));
      }

      function tick() {
        if (!up) return;
        var diff = Math.max(0, Date.now() - START.getTime());
        var d = Math.floor(diff / 86400000);
        var h = Math.floor(diff / 3600000) % 24;
        var m = Math.floor(diff / 60000) % 60;
        var s = Math.floor(diff / 1000) % 60;
        up.textContent = d + '天 ' + h + '小时 ' + m + '分 ' + s + '秒';
      }
      tick();
      window.setInterval(tick, 1000);

      var coloCities = {
        HKG: 'Hong Kong', NRT: 'Tokyo', KIX: 'Osaka', ICN: 'Seoul', SIN: 'Singapore', TPE: 'Taipei',
        LAX: 'Los Angeles', SJC: 'San Jose', SFO: 'San Francisco', SEA: 'Seattle', DFW: 'Dallas',
        ORD: 'Chicago', IAD: 'Ashburn', JFK: 'New York', YYZ: 'Toronto', GRU: 'São Paulo',
        FRA: 'Frankfurt', AMS: 'Amsterdam', LHR: 'London', CDG: 'Paris', MXP: 'Milan', MAD: 'Madrid'
      };

      fetch('/cdn-cgi/trace').then(function (r) { return r.text(); }).then(function (text) {
        var info = {};
        text.trim().split('\n').forEach(function (line) {
          var kv = line.split('=');
          info[kv[0]] = kv.slice(1).join('=');
        });
        if (serverEl && info.ip) {
          serverEl.textContent = '现在为您提供服务的服务器是 ' + flag(info.loc) + ' ' + (coloCities[info.colo] || info.colo || '') + '，IP: ' + info.ip + '，运营商: Cloudflare, Inc.';
          serverEl.hidden = false;
        }
      }).catch(function () {});

      fetch('https://ipwho.is/').then(function (r) { return r.json(); }).then(function (data) {
        if (!data || data.success === false || !data.ip || !visitorEl) return;
        var isp = data.connection && data.connection.isp ? '，运营商: ' + data.connection.isp : '';
        visitorEl.textContent = '您来自 ' + flag(data.country_code) + ' ' + (data.city || '') + '，IP: ' + data.ip + isp;
      }).catch(function () {});
    })();
  </script>
</Layout>
