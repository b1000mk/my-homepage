---
// convert.astro — 订阅转换工具
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="订阅转换 · b1000mk Tools"
  description="在线订阅格式转换工具，支持 Clash Meta、Sing-box、V2Ray、Surge 等多种格式。"
>
  <div class="page">

    <!-- Back nav -->
    <nav class="topnav anim-fade-up">
      <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 5-7 7 7 7"/></svg>
        返回主页
      </a>
      <span class="topnav-title">订阅转换</span>
    </nav>

    <!-- Hero -->
    <header class="convert-hero anim-fade-up anim-delay-1">
      <p class="eyebrow">Tools · 01</p>
      <h1 class="convert-title">订阅转换</h1>
      <p class="convert-desc">
        将机场订阅链接转换为任意客户端所需格式<br/>
        支持 Clash Meta · Sing-box · V2Ray · Surge · Quantumult X
      </p>
    </header>

    <!-- Converter Card -->
    <div class="converter-wrap anim-fade-up anim-delay-2">

      <!-- Step 1: Input -->
      <section class="conv-section">
        <div class="conv-section-head">
          <span class="conv-step">01</span>
          <h2 class="conv-step-label">订阅链接</h2>
          <span class="conv-badge">每行一个</span>
        </div>
        <textarea
          id="sub-input"
          class="sub-textarea"
          placeholder="https://your-subscription-url.com/sub?token=xxx&#10;https://another-url.com/..."
          rows="4"
          spellcheck="false"
          autocomplete="off"
        ></textarea>
        <div class="input-actions">
          <button class="small-btn" id="btn-paste" type="button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            粘贴
          </button>
          <button class="small-btn danger" id="btn-clear" type="button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            清空
          </button>
        </div>
      </section>

      <!-- Step 2: Format -->
      <section class="conv-section">
        <div class="conv-section-head">
          <span class="conv-step">02</span>
          <h2 class="conv-step-label">目标格式</h2>
        </div>
        <div class="format-grid" id="format-grid" role="radiogroup" aria-label="选择目标格式">
          <!-- filled by JS -->
        </div>
      </section>

      <!-- Step 3: Backend -->
      <section class="conv-section">
        <div class="conv-section-head">
          <span class="conv-step">03</span>
          <h2 class="conv-step-label">转换后端</h2>
          <span class="conv-badge">可自定义</span>
        </div>
        <div class="backend-row">
          <div class="backend-presets" id="backend-presets"></div>
          <input
            type="url"
            id="backend-custom"
            class="backend-input"
            placeholder="或输入自定义后端地址…"
          />
        </div>
      </section>

      <!-- Step 4: Options -->
      <section class="conv-section">
        <div class="conv-section-head">
          <span class="conv-step">04</span>
          <h2 class="conv-step-label">转换选项</h2>
          <span class="conv-badge">可选</span>
        </div>
        <div class="options-grid">
          <label class="toggle-label" for="opt-emoji">
            <span class="toggle-text">
              <span class="toggle-name">Emoji 国旗</span>
              <span class="toggle-desc">在节点名称中显示国家国旗</span>
            </span>
            <input type="checkbox" id="opt-emoji" checked role="switch"/>
            <span class="toggle-switch"></span>
          </label>
          <label class="toggle-label" for="opt-udp">
            <span class="toggle-text">
              <span class="toggle-name">启用 UDP</span>
              <span class="toggle-desc">开启 UDP 转发支持</span>
            </span>
            <input type="checkbox" id="opt-udp" checked role="switch"/>
            <span class="toggle-switch"></span>
          </label>
          <label class="toggle-label" for="opt-sort">
            <span class="toggle-text">
              <span class="toggle-name">节点排序</span>
              <span class="toggle-desc">按名称字母顺序排列</span>
            </span>
            <input type="checkbox" id="opt-sort" role="switch"/>
            <span class="toggle-switch"></span>
          </label>
          <label class="toggle-label" for="opt-rename">
            <span class="toggle-text">
              <span class="toggle-name">去除倍率标注</span>
              <span class="toggle-desc">移除节点名中的 ×2.0 等倍率信息</span>
            </span>
            <input type="checkbox" id="opt-rename" role="switch"/>
            <span class="toggle-switch"></span>
          </label>
        </div>

        <!-- Include / Exclude filter -->
        <div class="filter-row">
          <div class="filter-field">
            <label class="filter-label" for="opt-include">包含关键词</label>
            <input type="text" id="opt-include" class="filter-input" placeholder="HK|SG|JP（正则）"/>
          </div>
          <div class="filter-field">
            <label class="filter-label" for="opt-exclude">排除关键词</label>
            <input type="text" id="opt-exclude" class="filter-input" placeholder="剩余|到期|官网（正则）"/>
          </div>
        </div>
      </section>

      <!-- Generate -->
      <div class="conv-generate">
        <button class="gen-btn" id="btn-generate" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2H3v16h5v4l4-4h5l4-4V2z"/><path d="M11 11V7"/><path d="M14 11V7"/></svg>
          生成订阅链接
        </button>
      </div>

      <!-- Result -->
      <div class="conv-result" id="conv-result" hidden>
        <div class="result-head">
          <span class="result-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            已生成
          </span>
          <div class="result-actions">
            <button class="small-btn" id="btn-copy-result" type="button">复制链接</button>
            <button class="small-btn" id="btn-open-result" type="button">在新标签打开</button>
          </div>
        </div>
        <div class="result-url-wrap">
          <code class="result-url" id="result-url"></code>
        </div>

        <!-- Import shortcuts -->
        <div class="import-section">
          <p class="import-title">一键导入客户端</p>
          <div class="import-grid" id="import-grid"></div>
        </div>
      </div>

      <!-- Error -->
      <div class="conv-error" id="conv-error" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <span id="conv-error-msg"></span>
      </div>

    </div>

    <!-- Tips -->
    <section class="tips-section anim-fade-up anim-delay-3">
      <div class="section-head">
        <span class="section-num">Tips</span>
        <h2 class="section-title">使用说明</h2>
      </div>
      <div class="tips-grid">
        <div class="tip-card">
          <div class="tip-icon">🔗</div>
          <h3>粘贴订阅链接</h3>
          <p>将机场提供的订阅 URL 粘贴到输入框中，每行支持一个链接，多条链接会自动合并。</p>
        </div>
        <div class="tip-card">
          <div class="tip-icon">🎯</div>
          <h3>选择目标格式</h3>
          <p>根据您使用的客户端选择对应格式。Clash Meta / Mihomo 推荐选 <strong>Clash Meta</strong>，手机端推荐 <strong>Sing-box</strong>。</p>
        </div>
        <div class="tip-card">
          <div class="tip-icon">⚙️</div>
          <h3>自定义后端</h3>
          <p>默认使用公共后端。如有自建 Subconverter，填入地址即可。本站不存储任何订阅信息。</p>
        </div>
        <div class="tip-card">
          <div class="tip-icon">🔒</div>
          <h3>隐私说明</h3>
          <p>所有转换请求直接从您的浏览器发送至所选后端，本站服务器不参与中转，不记录日志。</p>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script is:inline>
(function () {
  /* ───────────── Config ───────────── */
  var FORMATS = [
    { id: 'clash',   label: 'Clash Meta',    sub: 'Mihomo',      icon: '⚡' },
    { id: 'singbox', label: 'Sing-box',       sub: 'JSON 格式',   icon: '📦', target: 'singbox' },
    { id: 'v2ray',   label: 'V2Ray',          sub: 'Base64',      icon: '🔷' },
    { id: 'surge',   label: 'Surge',          sub: 'Surge 4+',    icon: '🌊' },
    { id: 'quanx',   label: 'Quantumult X',   sub: 'QX',          icon: '🍎', target: 'quanx' },
    { id: 'loon',    label: 'Loon',           sub: 'Loon',        icon: '🎈' },
    { id: 'surfboard', label: 'Surfboard',    sub: 'Android',     icon: '🏄', target: 'surfboard' },
    { id: 'mixed',   label: 'Mixed',          sub: '混合节点',    icon: '🔀' },
  ];

  var BACKENDS = [
    { label: 'api.v1.mk',   url: 'https://api.v1.mk' },
    { label: 'sub.xeton.dev', url: 'https://sub.xeton.dev' },
    { label: 'sublink.dev', url: 'https://sublink.dev/sub' },
  ];

  /* ───────────── State ───────────── */
  var selectedFormat  = 'clash';
  var selectedBackend = BACKENDS[0].url;

  /* ───────────── DOM ───────────── */
  var subInput      = document.getElementById('sub-input');
  var formatGrid    = document.getElementById('format-grid');
  var backendPresets= document.getElementById('backend-presets');
  var backendCustom = document.getElementById('backend-custom');
  var btnPaste      = document.getElementById('btn-paste');
  var btnClear      = document.getElementById('btn-clear');
  var btnGenerate   = document.getElementById('btn-generate');
  var convResult    = document.getElementById('conv-result');
  var convError     = document.getElementById('conv-error');
  var convErrorMsg  = document.getElementById('conv-error-msg');
  var resultUrlEl   = document.getElementById('result-url');
  var btnCopyResult = document.getElementById('btn-copy-result');
  var btnOpenResult = document.getElementById('btn-open-result');
  var importGrid    = document.getElementById('import-grid');

  /* ───────────── Render formats ───────────── */
  FORMATS.forEach(function (f) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'format-btn' + (f.id === selectedFormat ? ' active' : '');
    btn.dataset.id = f.id;
    btn.setAttribute('role', 'radio');
    btn.setAttribute('aria-checked', f.id === selectedFormat ? 'true' : 'false');
    btn.innerHTML =
      '<span class="fmt-icon">' + f.icon + '</span>' +
      '<span class="fmt-label">' + f.label + '</span>' +
      '<span class="fmt-sub">' + f.sub + '</span>';
    btn.addEventListener('click', function () {
      selectedFormat = f.id;
      formatGrid.querySelectorAll('.format-btn').forEach(function (b) {
        b.classList.toggle('active', b.dataset.id === f.id);
        b.setAttribute('aria-checked', b.dataset.id === f.id ? 'true' : 'false');
      });
      hideResult();
    });
    formatGrid.appendChild(btn);
  });

  /* ───────────── Render backends ───────────── */
  BACKENDS.forEach(function (b, i) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'backend-preset' + (i === 0 ? ' active' : '');
    btn.textContent = b.label;
    btn.dataset.url = b.url;
    btn.addEventListener('click', function () {
      selectedBackend = b.url;
      backendCustom.value = '';
      backendPresets.querySelectorAll('.backend-preset').forEach(function (x) {
        x.classList.toggle('active', x.dataset.url === b.url);
      });
    });
    backendPresets.appendChild(btn);
  });

  backendCustom.addEventListener('input', function () {
    if (backendCustom.value.trim()) {
      selectedBackend = backendCustom.value.trim();
      backendPresets.querySelectorAll('.backend-preset').forEach(function (x) {
        x.classList.remove('active');
      });
    }
  });

  /* ───────────── Paste & Clear ───────────── */
  btnPaste.addEventListener('click', function () {
    if (!navigator.clipboard) return;
    navigator.clipboard.readText().then(function (t) { subInput.value += (subInput.value ? '\n' : '') + t.trim(); });
  });

  btnClear.addEventListener('click', function () {
    subInput.value = '';
    hideResult();
  });

  /* ───────────── Generate ───────────── */
  btnGenerate.addEventListener('click', function () {
    var raw = subInput.value.trim();
    if (!raw) { showError('请先粘贴订阅链接'); return; }

    var urls = raw.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
    if (!urls.length) { showError('未检测到有效链接'); return; }

    var backend = (backendCustom.value.trim() || selectedBackend).replace(/\/$/, '');

    // Build target param
    var fmtMap = { clash:'clash', singbox:'singbox', v2ray:'v2ray', surge:'surge', quanx:'quanx', loon:'loon', surfboard:'surfboard', mixed:'mixed' };
    var target = fmtMap[selectedFormat] || selectedFormat;

    // Build URL
    var params = new URLSearchParams();
    params.set('target', target);
    params.set('url', urls.join('|'));
    params.set('emoji', document.getElementById('opt-emoji').checked ? '1' : '0');
    params.set('udp',   document.getElementById('opt-udp').checked   ? '1' : '0');
    if (document.getElementById('opt-sort').checked)   params.set('sort', '1');
    if (document.getElementById('opt-rename').checked) params.set('rename', '!!(\\.?[xX](\\.?\\d+)?)$@');
    var inc = document.getElementById('opt-include').value.trim();
    var exc = document.getElementById('opt-exclude').value.trim();
    if (inc) params.set('include', inc);
    if (exc) params.set('exclude', exc);

    var finalUrl = backend + '/sub?' + params.toString();
    showResult(finalUrl);
  });

  function showResult(url) {
    convError.hidden = true;
    resultUrlEl.textContent = url;
    convResult.hidden = false;
    buildImportLinks(url);
    convResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideResult() {
    convResult.hidden = true;
    convError.hidden = true;
  }

  function showError(msg) {
    convResult.hidden = true;
    convErrorMsg.textContent = msg;
    convError.hidden = false;
  }

  /* ───────────── Copy & Open ───────────── */
  btnCopyResult.addEventListener('click', function () {
    var url = resultUrlEl.textContent;
    if (!navigator.clipboard) { return; }
    navigator.clipboard.writeText(url).then(function () {
      btnCopyResult.textContent = '✓ 已复制';
      setTimeout(function () { btnCopyResult.textContent = '复制链接'; }, 2000);
    });
  });

  btnOpenResult.addEventListener('click', function () {
    window.open(resultUrlEl.textContent, '_blank', 'noopener');
  });

  /* ───────────── Import shortcuts ───────────── */
  function buildImportLinks(url) {
    var enc = encodeURIComponent(url);
    var schemes = [];

    if (selectedFormat === 'clash') {
      schemes.push({ label: 'Clash Verge / Meta', href: 'clash://install-config?url=' + enc + '&name=b1000mk-sub', icon: '⚡' });
      schemes.push({ label: 'ClashX Pro', href: 'clash://install-config?url=' + enc, icon: '⚡' });
    }
    if (selectedFormat === 'singbox') {
      schemes.push({ label: 'Sing-box', href: 'sing-box://import-remote-profile?url=' + enc, icon: '📦' });
    }
    if (selectedFormat === 'quanx') {
      schemes.push({ label: 'Quantumult X', href: 'quantumult-x:///add-resource?remote-resource=' + enc, icon: '🍎' });
    }
    if (selectedFormat === 'loon') {
      schemes.push({ label: 'Loon', href: 'loon://import?sub=' + enc, icon: '🎈' });
    }
    if (selectedFormat === 'surge') {
      schemes.push({ label: 'Surge', href: 'surge:///install-config?url=' + enc, icon: '🌊' });
    }
    // Universal copy
    schemes.push({ label: '复制到剪贴板', href: null, icon: '📋', copy: url });

    importGrid.innerHTML = '';
    schemes.forEach(function (s) {
      var a;
      if (s.href) {
        a = document.createElement('a');
        a.href = s.href;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      } else {
        a = document.createElement('button');
        a.type = 'button';
        a.addEventListener('click', function () {
          if (navigator.clipboard) navigator.clipboard.writeText(s.copy).then(function () {
            a.querySelector('.import-label').textContent = '✓ 已复制';
            setTimeout(function () { a.querySelector('.import-label').textContent = '复制到剪贴板'; }, 2000);
          });
        });
      }
      a.className = 'import-btn';
      a.innerHTML = '<span class="import-icon">' + s.icon + '</span><span class="import-label">' + s.label + '</span>';
      importGrid.appendChild(a);
    });
  }
})();
</script>

<style>
/* ── Page nav ── */
.topnav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32px 0 0;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  color: var(--fg-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.back-link:hover { color: var(--blue); }
.topnav-title {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-subtle);
}

/* ── Convert Hero ── */
.convert-hero {
  padding: 56px 0 40px;
}
.convert-title {
  margin: 16px 0 0;
  font-family: var(--font-display);
  font-size: clamp(40px, 8vw, 80px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.03em;
  background: var(--grad-text);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.convert-desc {
  margin: 20px 0 0;
  font-size: 15px;
  line-height: 1.8;
  color: var(--fg-muted);
}

/* ── Converter Wrap ── */
.converter-wrap {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  backdrop-filter: blur(16px);
  overflow: hidden;
  margin-bottom: 72px;
}

/* ── Conv Section ── */
.conv-section {
  padding: 28px 32px;
  border-bottom: 1px solid var(--border);
}
.conv-section-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}
.conv-step {
  font-family: var(--font-display);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--blue);
  opacity: 0.7;
}
.conv-step-label {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 600;
  color: var(--fg);
}
.conv-badge {
  font-size: 11px;
  color: var(--fg-subtle);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 2px 10px;
}

/* ── Textarea ── */
.sub-textarea {
  width: 100%;
  padding: 14px 16px;
  background: rgba(0,0,0,0.25);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--fg);
  font-family: "JetBrains Mono", "Fira Code", monospace;
  font-size: 13px;
  line-height: 1.6;
  resize: vertical;
  outline: none;
  transition: border-color 0.2s;
}
.sub-textarea:focus { border-color: var(--blue); }
.sub-textarea::placeholder { color: var(--fg-subtle); }

.input-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

/* ── Small btn ── */
.small-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 500;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--fg-muted);
  cursor: pointer;
  transition: all 0.2s;
}
.small-btn:hover {
  border-color: var(--border-hover);
  color: var(--blue);
  background: var(--blue-dim);
}
.small-btn.danger:hover {
  border-color: rgba(248,113,113,0.35);
  color: #f87171;
  background: rgba(248,113,113,0.1);
}

/* ── Format grid ── */
.format-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px;
}
.format-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: rgba(0,0,0,0.2);
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
  text-align: left;
}
.format-btn:hover {
  border-color: var(--border-hover);
  background: var(--blue-dim);
}
.format-btn.active {
  border-color: var(--blue);
  background: rgba(96,165,250,0.12);
  box-shadow: 0 0 0 1px rgba(96,165,250,0.2);
}
.fmt-icon { font-size: 18px; }
.fmt-label {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
}
.format-btn.active .fmt-label { color: var(--blue); }
.fmt-sub { font-size: 11px; color: var(--fg-subtle); }

/* ── Backend ── */
.backend-row {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.backend-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.backend-preset {
